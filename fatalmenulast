_G.FatalityGetBestSilentAimTargetGlobal = function(Origin)
    if typeof(Origin) ~= "Vector3" then
        _G.TmpCam = game:GetService("Workspace").CurrentCamera
        Origin = _G.TmpCam and _G.TmpCam.CFrame.Position or Vector3.new()
    end
    
    _G.MaxAllowedAimRange = 300 -- Радиус сканирования 360 градусов (в студах)
    _G.Closest3DDistance = _G.MaxAllowedAimRange
    _G.BestTargetBonePartFound = nil
    
    for _, P in pairs(game:GetService("Players"):GetPlayers()) do
        if P == game:GetService("Players").LocalPlayer then continue end
        if _G.FatalityCanDamagePlayerPrivate and not _G.FatalityCanDamagePlayerPrivate(P) then continue end
        
        _G.E_Char = P.Character
        _G.E_BoneSelector = _G.cfg and _G.cfg.silentPart or "Head"
        if _G.E_BoneSelector == "Random" then _G.E_BoneSelector = (math.random(1, 2) == 1) and "Head" or "HumanoidRootPart" end
        _G.E_Part = _G.E_Char and (_G.E_Char:FindFirstChild(_G.E_BoneSelector) or _G.E_Char:FindFirstChild("Head"))
        
        if _G.E_Part then
            -- Считаем чистое расстояние в 3D пространстве вокруг нашего придурка
            _G.DistanceToEnemy3D = (Origin - _G.E_Part.Position).Magnitude
            
            if _G.DistanceToEnemy3D < _G.Closest3DDistance then
                -- Wall Check (проверка стен)
                if _G.cfg and _G.cfg.silentWall and _G.FatalityIsVisibleCheckPrivate then
                    _G.ScannedVisiblePart = _G.FatalityIsVisibleCheckPrivate(_G.E_Char, Origin)
                    if not _G.ScannedVisiblePart then continue end
                    _G.E_Part = _G.ScannedVisiblePart
                end
                
                _G.Closest3DDistance = _G.DistanceToEnemy3D
                _G.BestTargetBonePartFound = _G.E_Part
            end
        end
    end
    return _G.BestTargetBonePartFound
end
