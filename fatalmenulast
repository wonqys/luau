_G.FatalityGetClosestPlayerToCursor = function()
    _G.ClosestObj = nil
    _G.MaxMDist = (_G.cfg and _G.cfg.fov360Mode) and 999999 or (_G.cfg and _G.cfg.silentFov or 130)
    _G.LP = game:GetService("Players").LocalPlayer
    _G.MRoot = _G.LP.Character and _G.LP.Character:FindFirstChild("HumanoidRootPart")
    if not _G.MRoot then return nil end
    
    for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
        if p ~= _G.LP and p.Character and p.Character:FindFirstChildOfClass("Humanoid") and p.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            _G.BName = _G.cfg and _G.cfg.silentPart or "HumanoidRootPart"
            if _G.BName == "Random" then _G.BName = (math.random(1, 2) == 1) and "Head" or "HumanoidRootPart" end
            _G.TBone = p.Character:FindFirstChild(_G.BName)
            
            if _G.TBone then
                _G.ValidT = true
                if _G.cfg and _G.cfg.silentTeam and _G.LP.Team and p.Team then
                    _G.MTN, _G.ETN = _G.LP.Team.Name, p.Team.Name
                    if (_G.MTN == "Criminals" or _G.MTN == "Inmates") then
                        if _G.ETN ~= "Police" then _G.ValidT = false end
                    elseif (_G.MTN == "Police") then
                        if _G.ETN ~= "Criminals" and _G.ETN ~= "Inmates" then _G.ValidT = false end
                    end
                end
                
                if _G.ValidT then
                    _G.B2D, _G.OnScr = workspace.CurrentCamera:WorldToViewportPoint(_G.TBone.Position)
                    if _G.cfg.fov360Mode then
                        _G.Actual3DDist = (_G.MRoot.Position - _G.TBone.Position).Magnitude
                        if _G.Actual3DDist < _G.MaxMDist then
                            _G.ValidW = true
                            if _G.cfg and _G.cfg.silentWall and #workspace.CurrentCamera:GetPartsObscuringTarget({_G.TBone.Position}, {_G.LP.Character, p.Character}) > 0 then _G.ValidW = false end
                            if _G.ValidW then _G.MaxMDist = _G.Actual3DDist; _G.ClosestObj = _G.TBone end
                        end
                    else
                        if _G.OnScr then
                            _G.MDist = (Vector2.new(_G.B2D.X, _G.B2D.Y) - game:GetService("UserInputService"):GetMouseLocation()).Magnitude
                            if _G.MDist < _G.MaxMDist then
                                _G.ValidW = true
                                if _G.cfg and _G.cfg.silentWall and #workspace.CurrentCamera:GetPartsObscuringTarget({_G.TBone.Position}, {_G.LP.Character, p.Character}) > 0 then _G.ValidW = false end
                                if _G.ValidW then _G.MaxMDist = _G.MDist; _G.ClosestObj = _G.TBone end
                            end
                        end
                    end
                end
            end
        end
    end
    return _G.ClosestObj
end

