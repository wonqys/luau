        _G.TS:Create(_G.SubmitButton, _G.AnimInfo, {BackgroundColor3 = Color3.fromRGB(35, 165, 75)}):Play()
        if _G.ButtonGlow then _G.TS:Create(_G.ButtonGlow, _G.AnimInfo, {Color = Color3.fromRGB(100, 255, 140)}):Play() end
        task.wait(0.3)
        _G.ShutdownAndLaunchUI(function() LaunchHubCode() end)
    else
        _G.CurrentAttempts = _G.CurrentAttempts + 1
        local remaining = _G.MaxAttempts - _G.CurrentAttempts
        if remaining > 0 then
            if _G.AttemptsLabel then _G.AttemptsLabel.Text = "Attempts Left: <font color='rgb(255, 60, 60)'>" .. remaining .. " / 3</font>" end
            _G.SubmitButton.Text = "Access Denied"
            _G.TS:Create(_G.SubmitButton, _G.AnimInfo, {BackgroundColor3 = Color3.fromRGB(185, 30, 30)}):Play()
            if _G.ButtonGlow then _G.TS:Create(_G.ButtonGlow, _G.AnimInfo, {Color = Color3.fromRGB(255, 100, 100)}):Play() end
            _G.KeyInput.Text = ""
            task.wait(1.2)
            _G.SubmitButton.Text = "Verify And Inject"
            _G.TS:Create(_G.SubmitButton, _G.AnimInfo, {BackgroundColor3 = Color3.fromRGB(245, 30, 30)}):Play()
            if _G.ButtonGlow then _G.TS:Create(_G.ButtonGlow, _G.AnimInfo, {Color = Color3.fromRGB(255, 80, 80)}):Play() end
        else
            if _G.AttemptsLabel then _G.AttemptsLabel.Text = "Attempts Left: <font color='rgb(255, 60, 60)'>0 / 3</font>" end
            _G.SubmitButton.Text = "Kicking..."
            task.wait(0.5)
            if _G.StopFloat then _G.StopFloat() end
            if _G.TimeConnection then _G.TimeConnection:Disconnect() end
            _G.LocalPlayer:Kick("\n\nпошел нахуй ключ не верный\nлучше купи его в тг t.me/wonqys")
        end
    end
end

if _G.SubmitButton then _G.SubmitButton.MouseButton1Click:Connect(runVerification) end
