                if _G.UIS:IsKeyDown(Enum.KeyCode.A) then _G.FlyMovementVector = _G.FlyMovementVector - _G.FlyCamCFrame.RightVector end
                if _G.UIS:IsKeyDown(Enum.KeyCode.D) then _G.FlyMovementVector = _G.FlyMovementVector + _G.FlyCamCFrame.RightVector end
                
