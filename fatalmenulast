_G.FatalityApplyChamsToModelParts = function(toolModel, enable)
    for _, part in ipairs(toolModel:GetDescendants()) do
        if part:IsA("BasePart") or part:IsA("MeshPart") then
            if enable then
                -- Безопасно сохраняем дефолтные текстуры и цвета оружия
                if not part:FindFirstChild("FatalityOrigMat") then
                    _G.OrigMat = Instance.new("StringValue", part)
                    _G.OrigMat.Name = "FatalityOrigMat"
                    _G.OrigMat.Value = tostring(part.Material.Value)
                    
                    _G.OrigColor = Instance.new("Color3Value", part)
                    _G.OrigColor.Name = "FatalityOrigColor"
                    _G.OrigColor.Value = part.Color
                    
                    -- Сейвим текстуру сетки, если она есть
                    if part:IsA("MeshPart") and part.TextureID ~= "" then
                        _G.OrigTex = Instance.new("StringValue", part)
                        _G.OrigTex.Name = "FatalityOrigTex"
                        _G.OrigTex.Value = part.TextureID
                    end
                end
                
                -- [ХАК КРАСКИ]: Насильно стираем текстуру, чтобы цвет залил пушку полностью
                if part:IsA("MeshPart") then 
                    part.TextureID = "" 
                end
                
                -- Поджигаем неоновый глянец
                part.Material = Enum.Material.Neon
                part.Color = Color3.fromRGB(255, 10, 10) -- Сделали алый цвет еще более ярким
                
                if part:IsA("BasePart") then 
                    part.Transparency = _G.cfgVisualsPro and _G.cfgVisualsPro.weaponChamsOpacity or 0.2 
                end
            else
                -- Возвращаем пушке исходный вид, если галочка выключена
                if part:FindFirstChild("FatalityOrigMat") and part:FindFirstChild("FatalityOrigColor") then
                    part.Material = Enum.Material[part.FatalityOrigMat.Value]
                    part.Color = part.FatalityOrigColor.Value
                    part.Transparency = 0
                    
                    if part:IsA("MeshPart") and part:FindFirstChild("FatalityOrigTex") then
                        part.TextureID = part.FatalityOrigTex.Value
                        part.FatalityOrigTex:Destroy()
                    end
                    
                    part.FatalityOrigMat:Destroy()
                    part.FatalityOrigColor:Destroy()
                end
            end
        end
    end
end

