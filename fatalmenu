-- FATALITY VISUALS — ЧАСТЬ 5Г: ИНДИКАТОРЫ УРОНА (-HP), НИКИ И TARGET HUD [ПАТЧ]
-- =============================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Таблицы кэширования здоровья и пула всплывающих цифр урона
local lastHealthStorage = {}
local activeIndicators = {}

-- [ИНИЦИАЛИЗАЦИЯ СЛОЕВ TARGET HUD]
local THudBase = Drawing.new("Square")
THudBase.Visible, THudBase.Size, THudBase.Color, THudBase.Filled, THudBase.Transparency = false, Vector2.new(220, 70), Color3.fromRGB(10, 10, 10), true, 0.5

local THudStroke = Drawing.new("Square")
THudStroke.Visible, THudStroke.Size, THudStroke.Color, THudStroke.Filled, THudStroke.Thickness = false, Vector2.new(220, 70), Color3.fromRGB(235, 20, 20), false, 1.5

local THudName = Drawing.new("Text")
THudName.Visible, THudName.Size, THudName.Color, THudName.Font, THudName.Outline = false, 14, Color3.fromRGB(255, 255, 255), 2, true

local THudInfo = Drawing.new("Text")
THudInfo.Visible, THudInfo.Size, THudInfo.Color, THudInfo.Font, THudInfo.Outline = false, 11, Color3.fromRGB(150, 150, 150), 2, true

local THudHealthBarBG = Drawing.new("Line")
THudHealthBarBG.Visible, THudHealthBarBG.Color, THudHealthBarBG.Thickness = false, Color3.fromRGB(30, 30, 30), 4

local THudHealthBar = Drawing.new("Line")
THudHealthBar.Visible, THudHealthBar.Color, THudHealthBar.Thickness = false, Color3.fromRGB(235, 20, 20), 2

-- Привязка к деструктору END чита
local oldClearSuite = _G.clearAllDrawingObjectsPrivate
_G.clearAllDrawingObjectsPrivate = function()
    if oldClearSuite then pcall(oldClearSuite) end
    THudBase:Remove(); THudStroke:Remove(); THudName:Remove(); THudInfo:Remove(); THudHealthBarBG:Remove(); THudHealthBar:Remove()
    for _, ind in ipairs(activeIndicators) do ind.Object.Visible = false ind.Object:Remove() end
    activeIndicators = {}
end

-- Функция Wall Check для фильтрации Target HUD
local function checkTargetWalls(headPart)
    if not _G.cfg or not _G.cfg.wc then return true end
    local origin = Camera.CFrame.Position
    local direction = (headPart.Position - origin).Unit * 1000
    local ray = Ray.new(origin, direction)
    local hitPart = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, Camera, workspace.Terrain})
    return hitPart and hitPart:IsDescendantOf(headPart.Parent) or false
end

-- [ЕДИНЫЙ ВЕЧНЫЙ ПОТОК РЕНДЕРИНГА]
RunService.RenderStepped:Connect(function()
    if not _G.FatalityCheatGui or not _G.FatalityCheatGui.Parent then return end
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local showNames = _G.cfgVisualsPro and _G.cfgVisualsPro.drawNames
    
    for player, vis in pairs(_G.FatalityPlayerVisuals or {}) do
        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        local headPart = character and character:FindFirstChild("Head")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        if character and humanoid and player ~= LocalPlayer then
            -- [МЕХАНИКА ИНДИКАТОРОВ УРОНА: Считываем изменения здоровья]
            if not lastHealthStorage[player] then lastHealthStorage[player] = humanoid.Health end
            if lastHealthStorage[player] > humanoid.Health and humanoid.Health > 0 then
                local damageTaken = math.floor(lastHealthStorage[player] - humanoid.Health)
                lastHealthStorage[player] = humanoid.Health
                
                -- Если фича активна в меню, создаем всплывающий 2D-текст урона
                if _G.cfgVisualsPro and _G.cfgVisualsPro.damageInd and headPart then
                    local dmgText = Drawing.new("Text")
                    dmgText.Text = "-" .. tostring(damageTaken) -- Жёсткое добавление знака минус перед числом урона
                    dmgText.Size = 16
                    dmgText.Color = Color3.fromRGB(255, 35, 35) -- Насыщенный алый цвет Fatality
                    dmgText.Font = 2
                    dmgText.Outline = true
                    dmgText.Center = true
                    
                    table.insert(activeIndicators, {
                        Object = dmgText,
                        Position3D = headPart.Position + Vector3.new(math.random(-2,2), math.random(2,4), math.random(-2,2)),
                        LifeTime = 1.0 -- Живёт ровно одну секунду
                    })
                end
            else
                lastHealthStorage[player] = humanoid.Health
            end
            
            -- [ОТРИСОВКА НИКНЕЙМОВ ИГРОКОВ]
            if showNames and rootPart and humanoid.Health > 0 then
                local rootPos, isOnScreen = Camera:WorldToViewportPoint(rootPart.Position)
                if isOnScreen then
                    local boxHeight = 3200 / rootPos.Z
                    vis.NameText.Position = Vector2.new(rootPos.X, (rootPos.Y - boxHeight / 2) - 17)
                    vis.NameText.Text = player.Name
                    vis.NameText.Visible = true
                else vis.NameText.Visible = false end
            else vis.NameText.Visible = false end
        else vis.NameText.Visible = false end
    end
    
    -- [ОБРАБОТКА И АНИМАЦИЯ ЦИФР УРОНА (DAMAGE INDICATORS ЛЕТИТ ВВЕРХ)]
    for idx = #activeIndicators, 1, -1 do
        local ind = activeIndicators[idx]
        ind.LifeTime = ind.LifeTime - 0.016
        
        if ind.LifeTime <= 0 then
            ind.Object.Visible = false; ind.Object:Remove()
            table.remove(activeIndicators, idx)
        else
            local camPos, onScreen = Camera:WorldToViewportPoint(ind.Position3D)
            if onScreen and _G.cfgVisualsPro and _G.cfgVisualsPro.damageInd then
                ind.Object.Position = Vector2.new(camPos.X, camPos.Y)
                ind.Position3D = ind.Position3D + Vector3.new(0, 0.06, 0) -- Плавный полёт строго вверх
                ind.Object.Transparency = ind.LifeTime -- Эффект растворения (Fade Out)
                ind.Object.Visible = true
            else ind.Object.Visible = false end
        end
    end
    
    -- [ФИНАЛЬНАЯ ФИЛЬТРАЦИЯ И ОТРИСОВКА КАРТОЧКИ TARGET HUD]
    local target = _G.FatalityTargetForHud
    if _G.cfgVisualsPro and _G.cfgVisualsPro.targetHud and target and target.Character and target.Character:FindFirstChild("Head") then
        local thHum = target.Character:FindFirstChildOfClass("Humanoid")
        
        -- Выполняем Wall Check непосредственно перед выводом панели на экран
        if thHum and thHum.Health > 0 and checkTargetWalls(target.Character.Head) then
            local hudLocation = Vector2.new(screenCenter.X - 110, screenCenter.Y + 120)
            
            THudBase.Position = hudLocation; THudBase.Visible = true
            THudStroke.Position = hudLocation; THudStroke.Visible = true
            
            THudName.Position = hudLocation + Vector2.new(12, 12)
            THudName.Text = target.Name; THudName.Visible = true
            
            local teamStr = (target.Team and target.Team.Name) or "Neutral"
            THudInfo.Position = hudLocation + Vector2.new(12, 32)
            THudInfo.Text = "Team: " .. teamStr .. " | HP: " .. math.floor(thHum.Health)
            THudInfo.Visible = true
            
            THudHealthBarBG.From = hudLocation + Vector2.new(12, 54); THudHealthBarBG.To = hudLocation + Vector2.new(208, 54); THudHealthBarBG.Visible = true
            
            local pct = math.clamp(thHum.Health / thHum.MaxHealth, 0, 1)
            THudHealthBar.From = hudLocation + Vector2.new(12, 54); THudHealthBar.To = hudLocation + Vector2.new(12 + (196 * pct), 54); THudHealthBar.Visible = true
        else
            THudBase.Visible = false; THudStroke.Visible = false; THudName.Visible = false; THudInfo.Visible = false; THudHealthBarBG.Visible = false; THudHealthBar.Visible = false
        end
    else
        THudBase.Visible = false; THudStroke.Visible = false; THudName.Visible = false; THudInfo.Visible = false; THudHealthBarBG.Visible = false; THudHealthBar.Visible = false
    end
end)

