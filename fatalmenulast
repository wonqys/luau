    local bodyAV = rootPart:FindFirstChild("FatalitySpinVelocity")
    if enable then
        if not bodyAV then
            bodyAV = Instance.new("BodyAngularVelocity")
            bodyAV.Name = "FatalitySpinVelocity"
            bodyAV.MaxTorque = Vector3.new(0, math.huge, 0)
            bodyAV.Parent = rootPart
        end
        bodyAV.AngularVelocity = Vector3.new(0, speed * 0.4, 0)
    else
