-- FATALITY VISUALS — ЧАСТЬ 5Б: СТАБИЛЬНЫЙ РЕНДЕРИНГ ГЕОМЕТРИИ ESP И ХП
-- =============================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

_G.FatalityTargetForHud = nil
_G.FatalityClosestHudDistance = 99999

RunService.RenderStepped:Connect(function()
    if not _G.FatalityCheatGui or not _G.FatalityCheatGui.Parent then return end
    
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local screenBottom = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
    
    _G.FatalityTargetForHud = nil
    _G.FatalityClosestHudDistance = 99999
    local myTeamName = LocalPlayer.Team and LocalPlayer.Team.Name or ""
    
    for player, vis in pairs(_G.FatalityPlayerVisuals or {}) do
        local character = player.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        local headPart = character and character:FindFirstChild("Head")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        local function hideGeometry()
            vis.Top.Visible = false; vis.Bottom.Visible = false; vis.Left.Visible = false; vis.Right.Visible = false
            vis.Corner1.Visible = false; vis.Corner2.Visible = false; vis.Corner3.Visible = false; vis.Corner4.Visible = false
            vis.Corner5.Visible = false; vis.Corner6.Visible = false; vis.Corner7.Visible = false; vis.Corner8.Visible = false
            vis.Tracer.Visible = false; vis.HealthBarBG.Visible = false; vis.HealthBar.Visible = false
            for _, fLine in ipairs(vis.FillLines) do fLine.Visible = false end
        end
        
        if character and rootPart and humanoid and humanoid.Health > 0 and player ~= LocalPlayer then
            local rootPos, isOnScreen = Camera:WorldToViewportPoint(rootPart.Position)
            
            if isOnScreen then
                local boxWidth = 2200 / rootPos.Z
                local boxHeight = 3200 / rootPos.Z
                
                local topLeft = Vector2.new(rootPos.X - boxWidth / 2, rootPos.Y - boxHeight / 2)
                local bottomRight = Vector2.new(rootPos.X + boxWidth / 2, rootPos.Y + boxHeight / 2)
                local topRight = Vector2.new(bottomRight.X, topLeft.Y)
                local bottomLeft = Vector2.new(topLeft.X, bottomRight.Y)
                
                -- Жесткая подмена цвета элементов ESP строго по командам Prison Life
                local espColor = Color3.fromRGB(245, 20, 20)
                if player.Team then
                    local tName = player.Team.Name
                    if tName == "Criminals" then espColor = Color3.fromRGB(245, 20, 20)
                    elseif tName == "Guards" or tName == "Police" then espColor = Color3.fromRGB(0, 120, 255)
                    elseif tName == "Inmates" then espColor = Color3.fromRGB(255, 140, 0) end
                end
                
                -- Передаем потенциальную цель для Target HUD в Часть 5Г
                local mouseDist = (Vector2.new(rootPos.X, rootPos.Y) - screenCenter).Magnitude
                if mouseDist < _G.FatalityClosestHudDistance and mouseDist < 250 and headPart then
                    local isTeammate = (_G.cfg and _G.cfg.espT and player.Team == LocalPlayer.Team and player.Team ~= nil and player.Team.Name ~= "Neutral")
                    if myTeamName == "Criminals" and player.Team and player.Team.Name == "Inmates" then isTeammate = true end
                    
                    -- Проверка стен (Временно true, основная фильтрация будет в 5Г)
                    if not isTeammate then
                        _G.FatalityClosestHudDistance = mouseDist
                        _G.FatalityTargetForHud = player
                    end
                end
                
                -- 1. КЛАССИЧЕСКИЙ БОКС
                local showNormalBox = _G.cfgVisualsPro and _G.cfgVisualsPro.box2d
                vis.Top.Visible = showNormalBox; vis.Bottom.Visible = showNormalBox; vis.Left.Visible = showNormalBox; vis.Right.Visible = showNormalBox
                if showNormalBox then
                    vis.Top.From = topLeft; vis.Top.To = topRight; vis.Top.Color = espColor
                    vis.Bottom.From = bottomLeft; vis.Bottom.To = bottomRight; vis.Bottom.Color = espColor
                    vis.Left.From = topLeft; vis.Left.To = bottomLeft; vis.Left.Color = espColor
                    vis.Right.From = topRight; vis.Right.To = bottomRight; vis.Right.Color = espColor
                end
                
                -- 2. УГЛОВЫЕ БОКСЫ (CORNER BOX — ЦВЕТА СИНХРОНИЗИРОВАНЫ)
                local showCornerBox = _G.cfgVisualsPro and _G.cfgVisualsPro.cornerBox
                vis.Corner1.Visible = showCornerBox; vis.Corner2.Visible = showCornerBox; vis.Corner3.Visible = showCornerBox; vis.Corner4.Visible = showCornerBox
                vis.Corner5.Visible = showCornerBox; vis.Corner6.Visible = showCornerBox; vis.Corner7.Visible = showCornerBox; vis.Corner8.Visible = showCornerBox
                if showCornerBox then
                    local cLength = boxWidth * 0.25
                    vis.Corner1.From = topLeft; vis.Corner1.To = topLeft + Vector2.new(cLength, 0); vis.Corner1.Color = espColor
                    vis.Corner2.From = topLeft; vis.Corner2.To = topLeft + Vector2.new(0, cLength); vis.Corner2.Color = espColor
                    vis.Corner3.From = topRight; vis.Corner3.To = topRight + Vector2.new(-cLength, 0); vis.Corner3.Color = espColor
                    vis.Corner4.From = topRight; vis.Corner4.To = topRight + Vector2.new(0, cLength); vis.Corner4.Color = espColor
                    vis.Corner5.From = bottomLeft; vis.Corner5.To = bottomLeft + Vector2.new(cLength, 0); vis.Corner5.Color = espColor
                    vis.Corner6.From = bottomLeft; vis.Corner6.To = bottomLeft + Vector2.new(0, -cLength); vis.Corner6.Color = espColor
                    vis.Corner7.From = bottomRight; Lazy7 = espColor; vis.Corner7.To = bottomRight + Vector2.new(-cLength, 0); vis.Corner7.Color = espColor
                    vis.Corner8.From = bottomRight; vis.Corner8.To = bottomRight + Vector2.new(0, -cLength); vis.Corner8.Color = espColor
                end
                
                -- 3. ГРАДИЕНТ НА ТОРС
                local showGradient = _G.cfgVisualsPro and _G.cfgVisualsPro.boxGradient
                for idx, fLine in ipairs(vis.FillLines) do
                    fLine.Visible = showGradient
                    if showGradient then
                        local layerY = topLeft.Y + ((bottomRight.Y - topLeft.Y) * (idx / 28))
                        fLine.From = Vector2.new(topLeft.X, layerY); fLine.To = Vector2.new(bottomRight.X, layerY); fLine.Color = espColor
                    end
                end
                
                -- 4. ТРЕЙСЕРА
                local showTracers = _G.cfgVisualsPro and _G.cfgVisualsPro.drawTracers
                vis.Tracer.Visible = showTracers
                if showTracers then
                    vis.Tracer.From = screenBottom; vis.Tracer.To = Vector2.new(rootPos.X, bottomRight.Y); vis.Tracer.Color = espColor
                end
                
                -- 5. ХП БАР (ПОЛОСКА ЗДОРОВЬЯ)
                local showHealth = _G.cfgVisualsPro and _G.cfgVisualsPro.drawHealth
                vis.HealthBarBG.Visible = showHealth; vis.HealthBar.Visible = showHealth
                if showHealth then
                    local barX = topLeft.X - 6
                    vis.HealthBarBG.From = Vector2.new(barX, bottomLeft.Y); vis.HealthBarBG.To = Vector2.new(barX, topLeft.Y)
                    local hpPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                    local barHeight = (bottomRight.Y - topLeft.Y) * hpPercent
                    vis.HealthBar.From = Vector2.new(barX, bottomLeft.Y); vis.HealthBar.To = Vector2.new(barX, bottomLeft.Y - barHeight)
                    vis.HealthBar.Color = Color3.fromRGB(255 * (1 - hpPercent), 255 * hpPercent, 0)
                end
            else hideGeometry() end
        else hideGeometry() end
    end
end)

