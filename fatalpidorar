local RAIN_DROP_COUNT = 380 
local allDrops = {}
math.randomseed(os.time())

for i = 1, RAIN_DROP_COUNT do
    local drop = Instance.new("Frame")
    drop.BorderSizePixel = 0
    drop.AnchorPoint = Vector2.new(0.5, 0)
    drop.Parent = RainContainer
    local gradient = Instance.new("UIGradient")
    gradient.Rotation = 90
    gradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.7, 0.3),
        NumberSequenceKeypoint.new(1, 1)
    })
    gradient.Parent = drop

    local isBg = (i <= 250)
    local width, length, speed, baseAlpha, color
    if isBg then 
        width = 1 length = math.random(12, 18) speed = 0.015 + (math.random(0, 100) / 10000) baseAlpha = math.random(35, 60) / 100 color = Color3.fromRGB(180, 25, 25) 
    else 
        local sub = math.random(1, 2)
        if sub == 1 then width = 2 length = math.random(18, 24) speed = 0.025 + (math.random(0, 100) / 10000) baseAlpha = math.random(55, 75) / 100 else width = 3 length = math.random(26, 38) speed = 0.035 + (math.random(0, 100) / 10000) baseAlpha = math.random(75, 95) / 100 end
        color = Color3.fromRGB(245, 30, 30) 
    end
    drop.Size = UDim2.new(0, width, 0, length) drop.BackgroundColor3 = color drop.Rotation = -2
    table.insert(allDrops, {Object = drop, Speed = speed, Length = length, X = math.random(0, 10000) / 10000, Y = math.random(0, 10000) / 10000, Alpha = baseAlpha})
end

_G.RainConnection = game:GetService("RunService").RenderStepped:Connect(function(dt)
