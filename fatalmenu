local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- [АВТОНОМНЫЙ ЦИКЛ ДЛЯ СВЕЧЕНИЯ ТЕЛА (NEON CHAMS HIGHLIGHT)]
local function processPlayerHighlights()
    -- Свечение считывает строго свой собственный независимый тумблер из меню (_G.cfg.esp)
    local isChamsEnabled = _G.cfg and _G.cfg.esp
    
    for _, player in ipairs(Players:GetPlayers()) do 
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local currentHighlight = player.Character:FindFirstChild("FatHl")
            
            -- Дефолтный неоновый цвет Fatality для Baseplate и серверов без команд
            local coreColor = {Fill = Color3.fromRGB(245, 20, 20), Outline = Color3.fromRGB(255, 255, 255)}
            
            -- Автоматическая подмена цветов по фракциям Prison Life (если включен Team Check)
            if _G.cfg and _G.cfg.espT and player.Team and player.Team.Name ~= "Neutral" then
                local teamName = player.Team.Name
                if teamName == "Criminals" then 
                    coreColor.Fill = Color3.fromRGB(245, 20, 20)      -- Преступники: Красный
                elseif teamName == "Guards" or teamName == "Police" then 
                    coreColor.Fill = Color3.fromRGB(0, 120, 255)      -- Охрана тюрьмы: Синий
                elseif teamName == "Inmates" then 
                    coreColor.Fill = Color3.fromRGB(255, 140, 0)      -- Заключенные: Оранжевый
                end
            end
            
            -- Логика создания, обновления или удаления объекта Highlight внутри персонажа
            if currentHighlight and currentHighlight:IsA("Highlight") then
                if not isChamsEnabled then
                    -- Если тумблер выключили — моментально сносим хайлайт
                    currentHighlight:Destroy()
                elseif _G.cfg then
                    -- Если включен — плавно обновляем прозрачность из ползунков меню
                    currentHighlight.FillColor = coreColor.Fill
                    currentHighlight.FillTransparency = _G.cfg.espF
                    currentHighlight.OutlineTransparency = _G.cfg.espO
                end
            elseif isChamsEnabled and _G.cfg then
                -- Создаем новый чистый неоновый хайлайт, если его еще нет
                local newHighlight = Instance.new("Highlight")
                newHighlight.Name = "FatHl"
                newHighlight.AlwaysOnTop = true
                newHighlight.FillColor = coreColor.Fill
                newHighlight.OutlineColor = coreColor.Outline
                newHighlight.FillTransparency = _G.cfg.espF
                newHighlight.OutlineTransparency = _G.cfg.espO
                newHighlight.Parent = player.Character
            end
        end
    end
end

-- Активируем вечный цикл проверки хайлайтов в отдельном потоке task.spawn
_G.FatalityChamsLoopActive = true
task.spawn(function()
    while _G.FatalityChamsLoopActive do
        task.wait(0.2) -- Опрос раз в 0.2 секунды для высокой отзывчивости
        pcall(processPlayerHighlights)
    end
end)

