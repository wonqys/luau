-- [ПАТЧ МЫШКИ: ПРИНУДИТЕЛЬНЫЙ АНЛОК КУРСОРA СВЕРХУ ИГРЫ]
RunService.RenderStepped:Connect(function()
    local activeScreen = CoreGuiContainer:FindFirstChild("FatalityCheatMenuUI")
    local mainPanel = activeScreen and activeScreen:FindFirstChild("MainPanel")
    
    if mainPanel and mainPanel.Visible then
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
    end
end)

-- [ОБРАБОТКА НАЖАТИЙ КЛАВИШ (DELETE И END)]
UserInputService.InputBegan:Connect(function(input, processed)
    -- Если игрок пишет в чат — софт полностью игнорирует нажатия клавиш
    if UserInputService:GetFocusedTextBox() or processed then 
        return 
    end
    
    -- БИНД: DELETE (СМЫВАЕТ МЕНЮ НАМЕРТВО)
    if input.KeyCode == Enum.KeyCode.Delete then 
        local activeScreen = CoreGuiContainer:FindFirstChild("FatalityCheatMenuUI")
        local actualMainPanel = activeScreen and activeScreen:FindFirstChild("MainPanel")
        
        if actualMainPanel then
            -- ЖЕЛЕЗНЫЙ ИСПРАВЛЕННЫЙ ПЕРЕКЛЮЧАТЕЛЬ: Меняем видимость напрямую в обход флагов
            local nextState = not actualMainPanel.Visible
            actualMainPanel.Visible = nextState
            _G.ByPassOpened = nextState
            
            -- Синхронизируем фон, блур и дождь с панелью
            local bgUI = activeScreen:FindFirstChild("FatalityBackgroundUI")
            if bgUI then 
                bgUI.Enabled = nextState 
                local rain = bgUI:FindFirstChild("RainContainer")
                if rain then 
                    rain.Visible = nextState 
                end
            end 
            if _G.FatalityBlurObj then 
                _G.FatalityBlurObj.Enabled = nextState 
            end 
            if _G.FatalityDimObj then 
                _G.FatalityDimObj.BackgroundTransparency = nextState and 0.6 or 1 
            end 
        end
    end
    
    -- БИНД: END (Выгрузка)
    if input.KeyCode == Enum.KeyCode.End then 
        _G.FatalityChamsLoopActive = false 
        
        -- Снос всех активных потоков рендеринга софта
        if _G.RainConnection then pcall(function() _G.RainConnection:Disconnect() end) end 
        if _G.Fatality7Conn then pcall(function() _G.Fatality7Conn:Disconnect() end) end 
        if _G.FatalityCamConnection then pcall(function() _G.FatalityCamConnection:Disconnect() end) end 
        if _G.FatalityDynamicBoxEspConn then pcall(function() _G.FatalityDynamicBoxEspConn:Disconnect() end) end
        if _G.FatalityHudConnection then pcall(function() _G.FatalityHudConnection:Disconnect() end) end 
        
        -- Вызов очистки прицела и ватермарки из Части 4
        if _G.clearAllDrawingObjectsPrivate then pcall(_G.clearAllDrawingObjectsPrivate) end
        
        -- Вызов очистки 2D коробок из новой Части 5
        if _G.clearAllBoxEspObjectsPrivate then pcall(_G.clearAllBoxEspObjectsPrivate) end
        
        -- Стираем круг FOV аимбота
        if _G.FatalityDrawingCircle then 
            pcall(function() 
                _G.FatalityDrawingCircle.Visible = false 
                _G.FatalityDrawingCircle:Remove() 
            end) 
        end 
        
        -- Снос блура
        pcall(function()
            local blur = Lighting:FindFirstChild("FatalityBlur")
            if blur then blur:Destroy() end
            if _G.FatalityBlurObj then _G.FatalityBlurObj:Destroy() end
        end)
        
        -- Возврат тумана и камеры к дефолту сервера
        Lighting.FogColor = _G.defFogColor or Color3.fromRGB(128, 128, 128)
        Lighting.FogStart = _G.defFogStart or 0
        Lighting.FogEnd = _G.defFogEnd or 100000
        workspace.CurrentCamera.FieldOfView = 70
        
        -- Удаление ScreenGui интерфейса
        local endUI = CoreGuiContainer:FindFirstChild("FatalityCheatMenuUI")
        if endUI then pcall(function() endUI:Destroy() end) end 
        
        print("Софт успешно и полностью выгружен!")
    end
end)

