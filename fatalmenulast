        _G.FatalityBodyVelocityObj.velocity = Vector3.new(0, 0.1, 0)
        _G.FatalityBodyVelocityObj.maxForce = Vector3.new(9e5, 9e5, 9e5)
        _G.FatalityBodyVelocityObj.Parent = _G.F_Root
        
        task.spawn(function()
            while _G.FatalityFlyActivePrivate and _G.F_Root and _G.FatalityBodyVelocityObj do
                _G.FlyCamCFrame = workspace.CurrentCamera.CFrame
                _G.FlyMovementVector = Vector3.new(0, 0, 0)
                
                _G.UIS = game:GetService("UserInputService")
                if _G.UIS:IsKeyDown(Enum.KeyCode.W) then _G.FlyMovementVector = _G.FlyMovementVector + _G.FlyCamCFrame.LookVector end
