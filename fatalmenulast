-- [1. СИМУЛЯТОР ВЫСТРЕЛA + ХАК ОКРАШИВАНИЯ ОРИГИНАЛЬНОГО ТРЕЙСЕРА]
_G.FatalityNormalCastSimulationPrivate = function(p1, p2, p3)
    _G.CastOrigin, _G.CastAim, _G.CastTool = nil, nil, nil
    if typeof(p1) == "Vector3" then
        _G.CastOrigin = p1
        if typeof(p2) == "Vector3" then _G.CastAim = p2 elseif typeof(p3) == "Vector3" then _G.CastAim = p3 end
        if typeof(p2) == "Instance" then _G.CastTool = p2 elseif typeof(p3) == "Instance" then _G.CastTool = p3 end
    else
        _G.CastTool = p1
        if typeof(p2) == "Vector3" then _G.CastOrigin = p2 end
        if typeof(p3) == "Vector3" then _G.CastAim = p3 elseif typeof(p2) == "Vector3" then _G.CastAim = p2 end
    end
    if not _G.CastOrigin or not _G.CastAim then return nil, Vector3.new() end
    _G.CastDirectionVector = _G.CastAim - _G.CastOrigin
    if _G.CastDirectionVector.Magnitude <= 0 then _G.CastDirectionVector = Vector3.new(0, 0, -1) end
    _G.WeaponMaxFireRange = _G.FatalityGetToolAttributePrivate(_G.CastTool, "Range") or 200
    
    _G.CastParamsObj = RaycastParams.new()
    _G.CastParamsObj.FilterType = Enum.RaycastFilterType.Exclude
    _G.CastParamsObj.FilterDescendantsInstances = game:GetService("Players").LocalPlayer.Character and { game:GetService("Players").LocalPlayer.Character } or {}
    _G.CastParamsObj.CollisionGroup = "ClientBullet"
    
    -- Ловим оригинальную пулю в папке Effects для перекраски
    if _G.cfg.bulletTracers and workspace:FindFirstChild("Effects") then
        _G.TraceConn = workspace.Effects.ChildAdded:Connect(function(child)
            if child.Name == "Bullet" or child:IsA("BasePart") then
                pcall(function()
                    child.Color = Color3.fromRGB(255, 10, 10) -- Перекрашиваем в алый
                    child.Material = Enum.Material.Neon       -- Поджигаем неон
                end)
            end
        end)
        -- Авто-отключение прослушки через кадр, чтобы не жрать FPS
        task.delay(0.05, function() if _G.TraceConn then _G.TraceConn:Disconnect() end end)
    end

    _G.GlobalRaycastWorldResult = game:GetService("Workspace"):Raycast(_G.CastOrigin, _G.CastDirectionVector.Unit * _G.WeaponMaxFireRange, _G.CastParamsObj)
    if _G.GlobalRaycastWorldResult then return _G.GlobalRaycastWorldResult.Instance, _G.GlobalRaycastWorldResult.Position end
    return nil, _G.CastOrigin + _G.CastDirectionVector.Unit * _G.WeaponMaxFireRange
end

-- [2. ПОЛНЫЙ ВОЗВРАТ ДВИЖКА СAЙЛЕНТ АИМА С ФИKСОМ 360 И КОНФИГОВ]
_G.FatalityHookCastBypassPrivate = function(p1, p2, p3)
    _G.DetectedOrigin = nil
    if typeof(p1) == "Vector3" then _G.DetectedOrigin = p1
    elseif typeof(p2) == "Vector3" then _G.DetectedOrigin = p2
    elseif typeof(p3) == "Vector3" then _G.DetectedOrigin = p3 end
    
    if _G.DetectedOrigin and _G.cfg and _G.cfg.silentEn then
        _G.MySelfChar = game:GetService("Players").LocalPlayer.Character
        _G.MySelfRoot = _G.MySelfChar and _G.MySelfChar:FindFirstChild("HumanoidRootPart")
        
        if _G.MySelfRoot and (_G.DetectedOrigin - _G.MySelfRoot.Position).Magnitude <= 75 then
            -- Опрашиваем наш умный фракционный статус-чек из 12Б
            _G.FoundBestLimbTarget = _G.FatalityGetBestSilentAimTargetGlobal and _G.FatalityGetBestSilentAimTargetGlobal(_G.DetectedOrigin)
            
            if _G.FoundBestLimbTarget and _G.FoundBestLimbTarget.Parent then
                _G.HitChancePass = _G.FatalityCalculateHitChance and _G.FatalityCalculateHitChance(_G.cfg.silentChance or 100) or false
                
                if _G.HitChancePass then
                    -- Проверка стандартного узкого 2D FOV
                    if not _G.cfg.fov360Mode then
                        _G.CamViewportPoint, _G.IsTargetVisibleOnScreen = workspace.CurrentCamera:WorldToViewportPoint(_G.FoundBestLimbTarget.Position)
                        if not _G.IsTargetVisibleOnScreen then return _G.FatalityNormalCastSimulationPrivate(p1, p2, p3) end
                        
                        _G.CursorScreenLoc = game:GetService("UserInputService"):GetMouseLocation()
                        _G.CurrentAimMouseDist = (Vector2.new(_G.CamViewportPoint.X, _G.CamViewportPoint.Y) - _G.CursorScreenLoc).Magnitude
                        if _G.CurrentAimMouseDist > (_G.cfg.silentFov or 130) then return _G.FatalityNormalCastSimulationPrivate(p1, p2, p3) end
                    end
                    
                    -- Проверка препятствий (Стены), если валлбанг отключен в 12Б
                    if _G.cfg.silentWall then
                        _G.CheckParams = RaycastParams.new()
                        _G.CheckParams.FilterType = Enum.RaycastFilterType.Exclude
                        _G.CheckParams.FilterDescendantsInstances = {_G.MySelfChar, _G.FoundBestLimbTarget.Parent}
                        _G.WallCheckRay = game:GetService("Workspace"):Raycast(_G.DetectedOrigin, _G.FoundBestLimbTarget.Position - _G.DetectedOrigin, _G.CheckParams)
                        if _G.WallCheckRay then 
                            return _G.FatalityNormalCastSimulationPrivate(p1, p2, p3) 
                        end
                    end
                    
                    -- Если трейсер включен, подсвечиваем оригинальный луч до кости копа
                    if _G.cfg.bulletTracers then
                        task.spawn(_G.FatalityNormalCastSimulationPrivate, _G.DetectedOrigin, _G.FoundBestLimbTarget.Position)
                    end
                    
                    return _G.FoundBestLimbTarget, _G.FoundBestLimbTarget.Position
                end
