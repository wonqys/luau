        local function getRotatedPoint(distance, angleOffset)
            local finalAngle = math.rad(currentCrosshairAngle) + angleOffset
            return Vector2.new(center.X + math.cos(finalAngle) * distance, center.Y + math.sin(finalAngle) * distance)
        end
        local cGap, cSize, cThick = _G.cfg.crossGap or 4, _G.cfg.crossSize or 10, _G.cfg.crossThickness or 2
