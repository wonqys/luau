_G.FatalityIsHostileCheckPrivate = function(Char)
    _G.IsHostileOk, _G.HostileAttrVal = pcall(function() return Char:GetAttribute("Hostile") end)
    if _G.IsHostileOk and _G.HostileAttrVal ~= nil then return _G.HostileAttrVal == true end
    _G.HostileBoolObj = Char:FindFirstChild("Hostile")
    if _G.HostileBoolObj and _G.HostileBoolObj:IsA("BoolValue") then return _G.HostileBoolObj.Value end
    return false
end

_G.FatalityCanDamagePlayerPrivate = function(P)
    _G.TargetChar = P.Character
    if not _G.TargetChar then return false end
    _G.TargetHum = _G.TargetChar:FindFirstChildOfClass("Humanoid")
    if not _G.TargetHum or _G.TargetHum.Health <= 0 then return false end
    if _G.TargetChar:FindFirstChild("ForceField") then return false end
    
    if _G.cfg and _G.cfg.silentTeam then
        _G.MyCurrentTeam = game:GetService("Players").LocalPlayer.Team
        _G.TheirCurrentTeam = P.Team
        if _G.MyCurrentTeam and _G.TheirCurrentTeam and _G.MyCurrentTeam == _G.TheirCurrentTeam then return false end
        
        -- СТРОГАЯ HvH ЛОГИКА ДЛЯ КОМАНДЫ ПОЛИЦИИ (POLICE)
        if _G.MyCurrentTeam and _G.MyCurrentTeam.Name == "Police" then
            _G.MyCharModel = game:GetService("Players").LocalPlayer.Character
            _G.CurrentHeldTool = _G.MyCharModel and _G.MyCharModel:FindFirstChildOfClass("Tool")
            
            _G.IsHoldingRestraint = false
            if _G.CurrentHeldTool then
                _G.ToolNameStr = _G.CurrentHeldTool.Name:lower()
                -- Фильтруем, зажат ли в руках тазер или оригинальные наручники
                if _G.ToolNameStr:find("taser") or _G.ToolNameStr:find("handcuff") or _G.ToolNameStr:find("cuff") then
                    _G.IsHoldingRestraint = true
                end
            end
            
            -- [УЛЬТИМАТИВНЫЙ ТАЗЕР-ЛОК]: Если в руках шокер/наручники
            if _G.IsHoldingRestraint then
                if _G.TheirCurrentTeam then
                    _G.TName = _G.TheirCurrentTeam.Name
                    -- Лочим абсолютно ВСЕХ Заключенных (Inmates) и ВСЕХ сбежавших Преступников (Criminals) БЕЗ исключений!
                    if _G.TName == "Inmates" or _G.TName == "Criminals" then
                        return true
                    end
                end
                -- Дополнительная проверка: если челик сбросил команду, но имеет статус бунтаря — шьём его током
                if _G.FatalityIsHostileCheckPrivate(_G.TargetChar) then
                    return true
                end
            end
            
            -- [ЛЕГИТНЫЙ HvH-ОГНЕСТРЕЛ]: Если в руках автомат, пистолет или нож
            -- Аим лочит только бунтующих зэков или активных преступников (Criminals) с оружием
            if _G.TheirCurrentTeam and _G.TheirCurrentTeam.Name == "Criminals" then
                return true -- Преступников с базы за копов можно убивать всегда
            end
            
            -- Обычных зэков шьем только если они бунтуют, полностью игнорируя мирных и уже скованных в анимации
            if not _G.FatalityIsHostileCheckPrivate(_G.TargetChar) then return false end
            if _G.TargetChar:FindFirstChild("Handcuffs") or _G.TargetChar:FindFirstChild("Chain") or _G.TargetChar:GetAttribute("Handcuffed") == true then
                return false 
            end
        end
    end
    return true
end

_G.FatalityIsVisibleCheckPrivate = function(Char, Origin)
    _G.WallParams = RaycastParams.new()
    _G.WallParams.FilterType = Enum.RaycastFilterType.Exclude
    _G.WallParams.FilterDescendantsInstances = game:GetService("Players").LocalPlayer.Character and { game:GetService("Players").LocalPlayer.Character } or {}
    _G.CheckTargetPartsList = {
        Char:FindFirstChild(_G.cfg and _G.cfg.silentPart or "Head"), Char:FindFirstChild("Head"),
        Char:FindFirstChild("HumanoidRootPart"), Char:FindFirstChild("UpperTorso"),
        Char:FindFirstChild("LowerTorso"), Char:FindFirstChild("Torso"),
    }
    for _, CP in ipairs(_G.CheckTargetPartsList) do
        if not CP then continue end
        _G.RayDirectionVector = CP.Position - Origin
        if _G.RayDirectionVector.Magnitude <= 0 then continue end
        _G.RaycastWallResult = game:GetService("Workspace"):Raycast(Origin, _G.RayDirectionVector, _G.WallParams)
        if not _G.RaycastWallResult or _G.RaycastWallResult.Instance:FindFirstAncestorOfClass("Model") == Char then return CP end
    end
    return nil
end
