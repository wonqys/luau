    end
end

-- ФУНКЦИЯ ПОЛНОГО АНЛОАДА (Возвращаем дефолтный лимит)
local function unloadUnlocker()
    if not isUnlockerActive then return end
    isUnlockerActive = false
    
    if setfpscap then 
        setfpscap(60) -- Возвращаем стандартное ограничение Roblox в 60 FPS
    end
    
