-- [ФУНКЦИЯ СОЗДАНИЯ ПОЛНОГО ГРАФИЧЕСКОГО ПАКЕТА ДЛЯ ИГРОКА]
local function createPlayerEsp(player)
    if _G.FatalityPlayerVisuals[player] then return end
    
    local visuals = {
        -- Обычные полные боксы
        Top = Drawing.new("Line"), Bottom = Drawing.new("Line"),
        Left = Drawing.new("Line"), Right = Drawing.new("Line"),
        
        -- Угловые боксы (8 независимых линий для 4 углов)
        Corner1 = Drawing.new("Line"), Corner2 = Drawing.new("Line"),
        Corner3 = Drawing.new("Line"), Corner4 = Drawing.new("Line"),
        Corner5 = Drawing.new("Line"), Corner6 = Drawing.new("Line"),
        Corner7 = Drawing.new("Line"), Corner8 = Drawing.new("Line"),
        
        -- Линия трейсера от низа экрана
        Tracer = Drawing.new("Line"),
        
        -- Текст Никнейма
        NameText = Drawing.new("Text"),
        
        -- Полоски динамического здоровья
        HealthBarBG = Drawing.new("Line"),
        HealthBar = Drawing.new("Line"),
        
        -- Таблица слоев для премиум-градиента Fatality
        FillLines = {}
    }
    
    -- Настраиваем базовые свойства всех линий
    local allBaseLines = {
        visuals.Top, visuals.Bottom, visuals.Left, visuals.Right,
        visuals.Corner1, visuals.Corner2, visuals.Corner3, visuals.Corner4,
        visuals.Corner5, visuals.Corner6, visuals.Corner7, visuals.Corner8,
        visuals.Tracer, visuals.HealthBarBG, visuals.HealthBar
    }
    
    for _, line in ipairs(allBaseLines) do
        line.Visible = false
        line.Color = Color3.fromRGB(245, 20, 20)
        line.Thickness = 1.5
        line.Transparency = 1
    end
    
    -- Кастомизация полоски HP
    visuals.HealthBarBG.Color = Color3.fromRGB(30, 30, 30)
    visuals.HealthBarBG.Thickness = 2.5
    visuals.HealthBar.Color = Color3.fromRGB(0, 255, 100)
    visuals.HealthBar.Thickness = 1.5
    
    -- Кастомизация шрифта имени
    visuals.NameText.Visible = false
    visuals.NameText.Size = 13
    visuals.NameText.Color = Color3.fromRGB(255, 255, 255)
    visuals.NameText.Center = true
    visuals.NameText.Outline = true
    visuals.NameText.OutlineColor = Color3.fromRGB(0, 0, 0)
    visuals.NameText.Font = 2
    
    -- Нарезаем 15 ультратонких слоев, уходящих в прозрачность книзу
    for i = 1, 15 do
        local fLine = Drawing.new("Line")
        fLine.Visible = false
        fLine.Thickness = 1
        fLine.Color = Color3.fromRGB(245, 20, 20)
        fLine.Transparency = (16 - i) / 45 -- Чем ниже слой, тем он прозрачнее
        table.insert(visuals.FillLines, fLine)
    end
    
    _G.FatalityPlayerVisuals[player] = visuals
end

local function removePlayerEsp(player)
    if _G.FatalityPlayerVisuals[player] then
        local vis = _G.FatalityPlayerVisuals[player]
        for _, line in pairs(vis) do
            if type(line) == "table" then
                for _, fLine in ipairs(line) do fLine:Remove() end
            elseif type(line) == "userdata" then
                line:Remove()
            end
        end
        _G.FatalityPlayerVisuals[player] = nil
    end
end

-- [ГЛОБАЛЬНЫЙ ОЧИСТИТЕЛЬ DRAWING ПАМЯТИ ДЛЯ КНОПКИ END (ПАНИКА)]
_G.clearAllBoxEspObjectsPrivate = function()
    _G.FatalityChamsLoopActive = false
    if _G.FatalityDynamicBoxEspConn then pcall(function() _G.FatalityDynamicBoxEspConn:Disconnect() end) end
    
    for player, vis in pairs(_G.FatalityPlayerVisuals) do
        for _, line in pairs(vis) do
            if type(line) == "table" then
                for _, fLine in ipairs(line) do fLine.Visible = false fLine:Remove() end
            elseif type(line) == "userdata" then
                line.Visible = false line:Remove()
            end
        end
    end
    _G.FatalityPlayerVisuals = {}
    print("Память 2D ESP очищена под ноль!")
end

-- Запуск контроля за игроками
for _, p in pairs(Players:GetPlayers()) do createPlayerEsp(p) end
Players.PlayerAdded:Connect(createPlayerEsp)
Players.PlayerRemoving:Connect(removePlayerEsp)

print("Часть 5А (Ядро структур ESP) успешно загружена!")
