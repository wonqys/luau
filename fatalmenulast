local hiddenAtmosphereObjects = {}

local function applyAtmosphereEffects() 
    if _G.cfg.fog or _G.cfg.blackSky then 
        for _, object in ipairs(Lighting:GetChildren()) do
            if object:IsA("Atmosphere") or object:IsA("Sky") or object:IsA("Clouds") then
                table.insert(hiddenAtmosphereObjects, {Obj = object, OldParent = object.Parent})
                object.Parent = nil 
            end
        end
    end

    if _G.cfg.fog then 
        Lighting.FogColor = Color3.fromRGB(235, 20, 20)
        Lighting.FogStart = _G.cfg.fogS or 0
        Lighting.FogEnd = _G.cfg.fogE or 1000
    else 
        Lighting.FogColor = _G.defFogColor or Color3.fromRGB(128,128,128)
        Lighting.FogStart = _G.defFogStart or 0
        Lighting.FogEnd = _G.defFogEnd or 100000 
    end

    if _G.cfg.blackSky then
        Lighting.ClockTime = 0 
        Lighting.Ambient = Color3.fromRGB(30, 30, 30) 
        Lighting.OutdoorAmbient = Color3.fromRGB(10, 10, 10) 
        Lighting.Brightness = 0 
    else
        Lighting.ClockTime = 14 
        Lighting.Ambient = Color3.fromRGB(128, 128, 128)
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
        Lighting.Brightness = 1
    end

    if not _G.cfg.fog and not _G.cfg.blackSky then
        for _, data in ipairs(hiddenAtmosphereObjects) do
            if data.Obj then pcall(function() data.Obj.Parent = data.OldParent end) end
        end
        hiddenAtmosphereObjects = {}
    end
end

