_G.FatalityGetTaserTargetInChains = function()
    _G.BestTaserVictim = nil
    _G.MaxTaserDistance = 150 -- Максимальная дальность полета провода тайзера (в студах)
    
    _G.L_Player = game:GetService("Players").LocalPlayer
    _G.L_Root = _G.L_Player.Character and _G.L_Player.Character:FindFirstChild("HumanoidRootPart")
    
    if not _G.L_Root then return nil end
    
    for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
        -- Ищем цели только если мы за Ментов/Охрану, а цель — Заключенный или Криминал
        if p ~= _G.L_Player and p.Character and p.Team and (p.Team.Name == "Inmates" or p.Team.Name == "Criminals") then
            _G.V_Char = p.Character
            _G.V_Root = _G.V_Char:FindFirstChild("HumanoidRootPart")
            _G.V_Hum = _G.V_Char:FindFirstChildOfClass("Humanoid")
            
            if _G.V_Root and _G.V_Hum and _G.V_Hum.Health > 0 then
                _G.DistToInmate = (_G.L_Root.Position - _G.V_Root.Position).Magnitude
                
                if _G.DistToInmate <= _G.MaxTaserDistance then
                    -- Проверяем: бунтарь ли он, скован ли цепью/наручниками (Handcuffed) или сидит за решеткой спавна
                    _G.IsRebelInmate = false
                    
                    -- Проверка А: Твой кастомный Hostile-чек из Части 12Б
                    if _G.FatalityIsHostileCheckPrivate and _G.FatalityIsHostileCheckPrivate(_G.V_Char) then
                        _G.IsRebelInmate = true
                    end
                    
                    -- Проверка Б: Поиск объектов цепей, наручников или статуса ареста внутри модельки
                    if _G.V_Char:FindFirstChild("Handcuffs") or _G.V_Char:FindFirstChild("Chain") or _G.V_Char:GetAttribute("Handcuffed") == true then
                        _G.IsRebelInmate = true
                    end
                    
                    -- Если зэк бунтует или закован, фиксируем его как приоритет для пробития током
                    if _G.IsRebelInmate then
                        _G.MaxTaserDistance = _G.DistToInmate
                        _G.BestTaserVictim = _G.V_Root
                    end
                end
            end
        end
    end
    return _G.BestTaserVictim
end

