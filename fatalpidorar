local function LaunchHubCode()
    -- Вот сюда мы передаем прямую RAW-ссылку на твое меню из 1700 строк!
    local targetMenuLink = "https://raw.githubusercontent.com/wonqys/luau/main/fatalmenu"

    local success, scriptContent = pcall(function() 
        return game:HttpGet(targetMenuLink) 
    end)

    
    if success and scriptContent and not scriptContent:find("404: Not Found") and scriptContent ~= "" then
        -- Проверяем 1700 строк кода на синтаксические баги перед запуском
        local run, err = loadstring(scriptContent)
        if run then 
            -- Запускаем меню в защищенном режиме pcall (если чит упадет, Roblox не закроется)
            local executeSuccess, runtimeErr = pcall(run)
            if not executeSuccess then
                warn("[FATALITY CRITICAL RUNTIME ERROR]: Ошибка внутри меню софта! Код: " .. tostring(runtimeErr))
            end
        else 
            warn("[FATALITY SYNTAX ERROR]: Ошибка синтаксиса в 1700 строках меню! Сбой: " .. tostring(err)) 
        end
    else
        if _G.ActivateCheatMenu then 
            _G.ActivateCheatMenu() 
        else
            warn("[FATALITY LOADER ERROR]: GitHub raw ссылка на меню пуста или недоступна.")
        end
    end
end

