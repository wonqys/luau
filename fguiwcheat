local isUnlockerActive = true

-- АВТОМАТИЧЕСКИЙ ЗАПУСК ПРИ ИНЖЕКТЕ
local function startUnlocker()
    if setfpscap then 
        setfpscap(999) -- Снимаем лок кадров движка на максимум
        print("🔓 FPS успешно разблокирован! Лимит установлен на 999.")
