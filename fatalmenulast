RunService.RenderStepped:Connect(function()
    local activeScreen = CoreGuiContainer:FindFirstChild("FatalityCheatMenuUI")
    
    -- Проверяем активность самого ScreenGui
    if activeScreen and activeScreen.Enabled then
        local mainPanel = activeScreen:FindFirstChild("MainPanel")
