    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = Color3.fromRGB(160, 160, 160)
    Label.Font = Enum.Font.GothamSemibold
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame
    
    local isToggled = defaultValue
    local function updateVisuals()
        if isToggled then
            Button.BackgroundColor3 = Color3.fromRGB(245, 20, 20)
            Stroke.Color = Color3.fromRGB(245, 20, 20)
            Label.TextColor3 = Color3.fromRGB(245, 20, 20)
        else
            Button.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
            Stroke.Color = Color3.fromRGB(35, 35, 40)
            Label.TextColor3 = Color3.fromRGB(160, 160, 160)
        end
    end
    
    updateVisuals()
    Button.MouseButton1Click:Connect(function()
        isToggled = not isToggled
        updateVisuals()
        pcall(callback, isToggled)
    end)
end

-- [КОНСТРУКТОР СЛАЙДЕРОВ (SLIDERS) С ЗАЩИТОЙ ОТ ДЕЛЕНИЯ НА НОЛЬ]
_G.cSlider = function(parentContainer, text, minVal, maxVal, defaultVal, callback)
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(1, 0, 0, 42)
    Frame.BackgroundTransparency = 1
    Frame.Parent = parentContainer
    
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, 0, 0, 18)
    Label.BackgroundTransparency = 1
    Label.Text = text .. ": " .. tostring(defaultVal)
    Label.TextColor3 = Color3.fromRGB(160, 160, 160)
    Label.Font = Enum.Font.GothamSemibold
    Label.TextSize = 11
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Frame
    
    local SliderBG = Instance.new("TextButton")
    SliderBG.Size = UDim2.new(1, 0, 0, 5)
    SliderBG.Position = UDim2.new(0, 0, 0, 24)
    SliderBG.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    SliderBG.Text = ""
    SliderBG.Parent = Frame
    
    local CornerBG = Instance.new("UICorner")
    CornerBG.CornerRadius = UDim.new(0, 3)
    CornerBG.Parent = SliderBG
    
    local SliderFill = Instance.new("Frame")
    SliderFill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
    SliderFill.BackgroundColor3 = Color3.fromRGB(245, 20, 20)
    SliderFill.BorderSizePixel = 0
    SliderFill.Parent = SliderBG
    
    local CornerFill = Instance.new("UICorner")
    CornerFill.CornerRadius = UDim.new(0, 3)
    CornerFill.Parent = SliderFill
    
    local isDragging = false
    local function updateSlider(input)
        -- ЖЕЛЕЗНЫЙ ЗАЩИТНЫЙ ФИКС: Если размер полосы 0 (инжект на загрузке плейса) — блокируем расчет, спасая GUI от краша
        if SliderBG.AbsoluteSize.X == 0 then return end 
        
        local percent = math.clamp((input.Position.X - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X, 0, 1)
        SliderFill.Size = UDim2.new(percent, 0, 1, 0)
        local value = math.floor((minVal + (percent * (maxVal - minVal))) * 100 + 0.5) / 100
        Label.Text = text .. ": " .. tostring(value)
        pcall(callback, value)
    end
    
    SliderBG.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = true
            updateSlider(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isDragging = false
        end
    end)
end

