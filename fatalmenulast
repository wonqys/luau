-- Полностью глобальная логика для безопасного инжекта без лимита регистров
_G.FatalityHookJumpCircleLogic = function(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    
    if humanoid and rootPart then
        humanoid.StateChanged:Connect(function(oldState, newState)
            -- Срабатывает строго в момент прыжка, если тумблер активен
            if newState == Enum.HumanoidStateType.Jumping and _G.cfg and _G.cfg.jumpCircle then
                
                -- Генерируем плоский диск на полу
                _G.CirclePartObj = Instance.new("Part")
                _G.CirclePartObj.Name = "FatalityRotatedJumpCircle"
                _G.CirclePartObj.Size = Vector3.new(0.2, 0.1, 0.2)
                -- Сажаем строго на пол под ноги нашего придурка
                _G.CirclePartObj.Position = rootPart.Position - Vector3.new(0, 2.9, 0)
                _G.CirclePartObj.Transparency = 1
                _G.CirclePartObj.Anchored = true
                _G.CirclePartObj.CanCollide = false
                _G.CirclePartObj.Parent = workspace
                
                -- Накатываем оригинальную текстуру логотипа спавна из ресурсов Roblox
                _G.CircleDecalObj = Instance.new("Decal", _G.CirclePartObj)
                _G.CircleDecalObj.Face = Enum.NormalId.Top
                _G.CircleDecalObj.Texture = "rbxassetid://11843372271"
                _G.CircleDecalObj.Color3 = Color3.fromRGB(235, 20, 20) -- Фирменный алый
                _G.CircleDecalObj.Transparency = 0.2 -- Стартовая сочность
                
                -- Настройки времени и анимации
                _G.MaxRadiusSize = _G.cfg.jumpCircleRadius or 10
                _G.EffectTweenInfo = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                
                -- Запускаем плавное радиальное расширение круга
                _G.ExpandTweenAction = TweenService:Create(_G.CirclePartObj, _G.EffectTweenInfo, {
                    Size = Vector3.new(_G.MaxRadiusSize, 0.1, _G.MaxRadiusSize)
                })
                
                -- Запускаем идеальное бесшовное растворение текстуры спавна
                _G.FadeTweenAction = TweenService:Create(_G.CircleDecalObj, _G.EffectTweenInfo, {
                    Transparency = 1
                })
                
                _G.ExpandTweenAction:Play()
                _G.FadeTweenAction:Play()
                
                -- [БЕШЕНОЕ ВРАЩЕНИЕ КРУГА ПРИ РАЗЛЁТЕ]
                local targetPart = _G.CirclePartObj
                local currentRotationAngle = 0
                local rotationSpeed = 350 -- Скорость кручения (градусы в секунду)
                
                local spinConnection
                spinConnection = RunService.Heartbeat:Connect(function(deltaTime)
                    if targetPart and targetPart.Parent then
                        currentRotationAngle = (currentRotationAngle + (rotationSpeed * deltaTime)) % 360
                        targetPart.CFrame = CFrame.new(targetPart.Position) * CFrame.Angles(0, math.rad(currentRotationAngle), 0)
                    else
                        if spinConnection then spinConnection:Disconnect() end
                    end
                end)
                
                -- Полная зачистка объектов и потоков из памяти через 0.7 сек
                task.delay(0.7, function()
                    if spinConnection then spinConnection:Disconnect() end
                    if targetPart then targetPart:Destroy() end
                end)
            end
        end)
    end
end

