        local head = character and character:FindFirstChild("Head")
        
        if player ~= LocalPlayer and character and humanoid and head then
            -- Если игрока нет в кэше старого здоровья — заносим его текущие данные
            if not _G.FatalityDmgIndicatorsCache[player] then _G.FatalityDmgIndicatorsCache[player] = humanoid.Health end
            
            -- Проверка: если здоровье уменьшилось, фиксируем урон
            if _G.FatalityDmgIndicatorsCache[player] > humanoid.Health and humanoid.Health > 0 then
                local damageValue = math.floor(_G.FatalityDmgIndicatorsCache[player] - humanoid.Health)
                _G.FatalityDmgIndicatorsCache[player] = humanoid.Health
                
                -- Если фича активирована тумблером в меню, запускаем 3D-фонтан
                if _G.cfgVisualsPro and _G.cfgVisualsPro.damageInd then
                    local textObj = Drawing.new("Text")
                    textObj.Text = "-" .. tostring(damageValue)
                    textObj.Font = 2; textObj.Outline = true; textObj.Center = true
                    
                    -- ДИНАМИЧЕСКИЙ КРИТ-ЧЕК: Если урон жирный, увеличиваем размер и красим в оранжевый
                    if damageValue >= 25 then
                        textObj.Size = 22; textObj.Color = Color3.fromRGB(255, 140, 0)
                    else
                        textObj.Size = 15; textObj.Color = Color3.fromRGB(245, 20, 20)
                    end
                    
                    -- Придаем начальное случайное физическое ускорение (Разброс по сторонам и сильный подброс вверх)
                    local randomVelocity = Vector3.new(
                        math.random(-22, 22) / 7, -- Вектор X (Влево/Вправо)
                        math.random(28, 48) / 7,  -- Вектор Y (Импульс вверх)
                        math.random(-22, 22) / 7  -- Вектор Z
                    )
                    
                    table.insert(advancedActiveIndicators, {
                        Object = textObj,
                        Position3D = head.Position,
                        Velocity3D = randomVelocity,
                        LifeTime = 1.0 -- Живёт ровно одну секунду
                    })
                end
            else
                _G.FatalityDmgIndicatorsCache[player] = humanoid.Health
            end
        end
    end

    -- 2. СИМУЛЯЦИЯ ГРАВИТАЦИИ И ПЛАВНОГО ЗАТУХАНИЯ (FADE OUT)
    for i = #advancedActiveIndicators, 1, -1 do
        local indicator = advancedActiveIndicators[i]
        indicator.LifeTime = indicator.LifeTime - deltaTime
        
        if indicator.LifeTime <= 0 then
            indicator.Object.Visible = false; indicator.Object:Remove()
            table.remove(advancedActiveIndicators, i)
        else
            -- Воздействуем силой гравитации на вектор скорости (цифры плавно падают обратно)
            indicator.Velocity3D = indicator.Velocity3D - Vector3.new(0, 9.8 * deltaTime * 1.5, 0)
            indicator.Position3D = indicator.Position3D + (indicator.Velocity3D * deltaTime * 12)
            
            local camPos, onScreen = Camera:WorldToViewportPoint(indicator.Position3D)
            if onScreen and _G.cfgVisualsPro and _G.cfgVisualsPro.damageInd then
                indicator.Object.Position = Vector2.new(camPos.X, camPos.Y)
                
                -- Текстовые эффекты: текст плавно уменьшается и растворяется к концу жизни
                indicator.Object.Size = math.clamp(18 * (indicator.LifeTime / 1.0), 10, 22)
                indicator.Object.Transparency = math.clamp(indicator.LifeTime * 1.5, 0, 1)
                indicator.Object.Visible = true
            else
                indicator.Object.Visible = false
            end
        end
    end
end)

