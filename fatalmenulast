    local char = LocalPlayer.Character
    if not char then return end
    
    -- Ищем активный ствол в руках нашего персонажа
    char.ChildAdded:Connect(function(tool)
        if tool:IsA("Tool") and tool:FindFirstChild("Muzzle") then
            -- Привязываемся к событию активации/выстрела пушки
            tool.Activated:Connect(function()
                local muzzle = tool:FindFirstChild("Muzzle")
                local mouse = LocalPlayer:GetMouse()
                if muzzle and mouse then
                    -- Фиксируем 3D координаты: от дула ствола до клика мышки/головы врага
                    task.spawn(onBulletFired, muzzle.Position, mouse.Hit.Position)
                end
            end)
        end
    end)
end

