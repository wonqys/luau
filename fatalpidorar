    if dt > 0.05 then dt = 0.05 end
    for _, data in ipairs(allDrops) do
        data.Y = data.Y + (data.Speed * dt * 5.5) data.X = data.X + (data.Speed * 0.04 * dt * 5.5)
        if data.Y > 1.05 then data.Y = -0.05 data.X = math.random(0, 10000) / 10000 end
        if data.X > 1.02 then data.X = -0.02 elseif data.X < -0.02 then data.X = 1.02 end
        data.Object.Visible = _G.RainLinesVisible data.Object.Position = UDim2.fromScale(data.X, data.Y) data.Object.BackgroundTransparency = (1 - data.Alpha) * (_G.RainAlphaMultiplier or 1)
